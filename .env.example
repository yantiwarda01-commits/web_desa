# ============================================
# Environment Variables - Website Desa Sejahtera
# Copy file ini menjadi .env dan sesuaikan nilai-nilainya
# ============================================

# ============================================
# APPLICATION SETTINGS
# ============================================
APP_NAME="Website Desa Sejahtera"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
TZ=Asia/Jakarta

# ============================================
# DATABASE SETTINGS (MySQL)
# ============================================
DB_HOST=proxysql
DB_PORT=6033
DB_NAME=db_desa_sejahtera
DB_USER=desa_user
DB_PASS=desa_pass_2024

# MySQL Root Password (untuk maintenance)
MYSQL_ROOT_PASSWORD=root_password_secure_2024

# ============================================
# PROXYSQL SETTINGS
# ============================================
PROXYSQL_ADMIN_USER=admin
PROXYSQL_ADMIN_PASS=admin
PROXYSQL_MYSQL_PORT=6033
PROXYSQL_ADMIN_PORT=6032

# ============================================
# WEB SERVER SETTINGS
# ============================================
WEB_PORT=8080
PHPMYADMIN_PORT=8081

# PHP Configuration
PHP_MEMORY_LIMIT=256M
PHP_UPLOAD_MAX_FILESIZE=10M
PHP_POST_MAX_SIZE=12M
PHP_MAX_EXECUTION_TIME=300

# ============================================
# DOCKER SETTINGS
# ============================================
DOCKER_ENVIRONMENT=true
COMPOSE_PROJECT_NAME=desa-sejahtera

# ============================================
# SECURITY SETTINGS
# ============================================
# Generate random key untuk production:
# php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# Session settings
SESSION_LIFETIME=120
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=false

# ============================================
# BACKUP SETTINGS
# ============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=7

# ============================================
# MONITORING & LOGGING
# ============================================
LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_MAX_FILES=14

# ============================================
# MAIL SETTINGS (Optional - untuk notifikasi)
# ============================================
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@desasejahtera.id
MAIL_FROM_NAME="Website Desa Sejahtera"
